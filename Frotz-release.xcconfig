//
//  Frotz-release.xcconfig
//  Frotz
//
//  Base configuration for the Release and Distribution configurations: the CocoaPods settings
//  plus the build number. The number lives in buildnumber.xcconfig so that one file is shared
//  with Frotz-debug.xcconfig and is what the "Update Build Number" build phase rewrites.
//
#include "Pods/Target Support Files/Pods-Frotz/Pods-Frotz.release.xcconfig"

#include "Pods/Target Support Files/Pods-Frotz/Pods-Frotz.distribution.xcconfig" // same as release version
// These two includes have the same contents; including twice is harmless, and prevents 'pod install'
// from generating a warning without having to clone this file to have two different top-level configs for release/dist.

#include "buildnumber.xcconfig"
